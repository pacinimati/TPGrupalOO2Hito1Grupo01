<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Plato" table="plato">
        <!-- Nótese que el getter en Java es getIdPlato() pero la propiedad interna se llama id -->
        <id name="id" column="idPlato">
            <generator class="identity"/>
        </id>
        <property name="nombre" column="nombre" type="string"/>
        <property name="precioVenta" column="precioVenta" type="float"/>
        <property name="costoProduccion" column="costoProduccion" type="float"/>
    </class>
</hibernate-mapping>