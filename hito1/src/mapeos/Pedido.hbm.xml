<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping>
    <class name="datos.Pedido" table="pedido">
        <id name="id" column="idPedido">
            <generator class="identity"/>
        </id>
        <property name="fechaTransaccion" column="fechaTransaccion" type="LocalDate"/>

        <!-- Relación N a 1 con UnidadVenta -->
        <many-to-one name="unidadVenta" class="datos.UnidadVenta" column="idUnidadVenta" not-null="true"/>

        <!-- Relación 1 a N con ItemPedido -->
        <set name="lstItems" table="item_pedido" cascade="all" lazy="true">
            <key column="idPedido" not-null="true"/>
            <one-to-many class="datos.ItemPedido"/>
        </set>
    </class>
</hibernate-mapping>